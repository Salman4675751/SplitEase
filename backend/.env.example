PORT=5000
MONGODB_URI=mongodb://localhost:27017/splitwise
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Email (optional) ────────────────────────────────────────
# If not set, emails are logged to the console (dev mode).
# Examples:
#   Gmail SMTP:   smtp.gmail.com / 587 / your-email@gmail.com / app-password
#   Mailtrap:     sandbox.smtp.mailtrap.io / 2525 / your-mailtrap-user / password
#   SendGrid:     smtp.sendgrid.net / 587 / apikey / SG.xxxxx
#   Resend SMTP:  smtp.resend.com / 587 / resend / re_xxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SplitEase <no-reply@splitease.app>"
